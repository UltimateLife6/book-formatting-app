# Copy to apps/mobile/.env to override. All values are optional; defaults are used when unset.
# Only the local Firebase Emulator Suite is supported in this build.
EXPO_PUBLIC_FIREBASE_MODE=emulator
# Must start with "demo-": Firebase guarantees demo projects never touch real resources.
EXPO_PUBLIC_FIREBASE_PROJECT_ID=demo-folio-loom
# Default: 127.0.0.1 (iOS simulator) or 10.0.2.2 (Android emulator). Physical device: your computer's LAN IP,
# and start the emulators with host 0.0.0.0 (see docs/setup.md).
# EXPO_PUBLIC_FIREBASE_EMULATOR_HOST=192.168.1.20
EXPO_PUBLIC_FIREBASE_AUTH_EMULATOR_PORT=9099
