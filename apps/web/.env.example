# Copy to apps/web/.env.local to override. All values are optional; the defaults below are used
# when unset. Only the local Firebase Emulator Suite is supported in this build.
NEXT_PUBLIC_FIREBASE_MODE=emulator
# Must start with "demo-": Firebase guarantees demo projects never touch real resources.
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-folio-loom
NEXT_PUBLIC_FIREBASE_EMULATOR_HOST=127.0.0.1
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_PORT=9099
NEXT_PUBLIC_FIREBASE_FIRESTORE_EMULATOR_PORT=8080
