{
  "name": "@folio-loom/local-storage",
  "version": "0.0.0",
  "private": true,
  "description": "Offline, account-scoped manuscript storage: shared contract and logic, SQLite and IndexedDB drivers, autosave.",
  "type": "module",
  "main": "./src/index.ts",
